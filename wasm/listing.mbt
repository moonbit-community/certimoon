// The theory as a document: every definition, datatype, relation and
// lemma the package makes, in the order it makes them, with the kernel's
// statement of each. `listing` writes it; wasm/theory_test.mbt keeps it
// in __snapshot__/theory.md, so the file always says what is proved.

///|
/// One entry of the listing: a heading, a datatype or constant (`text`),
/// or a definition, relation or lemma (`th`, its statement).
priv struct Entry {
  kind : String
  name : String
  th : @kernel.Thm?
  text : String
}

///|
let entries : Array[Entry] = []

///|
/// A heading for the entries that follow.
fn section(title : String) -> Unit {
  entries.push({ kind: "section", name: title, th: None, text: "" })
}

///|
fn list_entry(kind : String, name : String, th : @kernel.Thm) -> Unit {
  entries.push({ kind, name, th: Some(th), text: "" })
}

///|
fn list_text(kind : String, name : String, text : String) -> Unit {
  entries.push({ kind, name, th: None, text })
}

///|
/// The word types, as the term syntax prints them, and short names for
/// them (longest first, so a longer type is replaced before its parts).
let type_names : Array[(String, String)] = [
  ("Word[Tybit0[Tybit0[Tybit0[Tybit0[Tybit0[Tybit0[Tybit0[Unit]]]]]]]]", "W128"),
  ("Word[Tybit0[Tybit0[Tybit0[Tybit0[Tybit0[Tybit0[Unit]]]]]]]", "W64"),
  ("Word[Tybit0[Tybit0[Tybit0[Tybit0[Tybit0[Unit]]]]]]", "W32"),
  ("Word[Tybit0[Tybit0[Tybit0[Unit]]]]", "Byte"),
]

///|
/// `s` with the word types written by their short names.
pub fn abbreviate_types(s : String) -> String {
  let mut out = s
  for p in type_names {
    out = out.replace_all(old=p.0, new=p.1)
  }
  out
}

///|
fn show_statement(th : @kernel.Thm) -> String {
  let t = @kernel.concl(th)
  @term_syntax.print_term(t) catch {
    _ => (try @printer.string_of_term(t) catch { _ => "?" })
  }
}

///|
/// The listing in Markdown: `items` are (kind, name, statement), and a
/// ("section", title, _) is a heading for the items after it.
pub fn render_listing(
  title : String,
  intro : String,
  items : Array[(String, String, String)],
) -> String {
  let buf = StringBuilder()
  buf.write_string("# " + title + "\n\n" + intro + "\n")
  for e in items {
    let (kind, name, text) = e
    if kind == "section" {
      buf.write_string("\n## " + name + "\n")
    } else {
      buf.write_string("\n" + kind + " `" + name + "`\n\n```\n" + text + "\n```\n")
    }
  }
  buf.to_string()
}

///|
/// What this package defines and proves (loading it, and the facts about
/// reduction), as Markdown.
pub fn listing() -> String raise {
  load()
  props()
  let items = entries.map(fn(e) raise {
    let text = match e.th {
      Some(th) if e.kind == "relation" =>
        @bool.conjuncts_rule(th).to_array().map(show_statement).join("\n")
      Some(th) => show_statement(th)
      None => e.text
    }
    (e.kind, e.name, abbreviate_types(text))
  })
  render_listing(
    "WasmCert in hol_light",
    "What package `wasm` defines and proves, in order: each definition, datatype, relation (one rule per line) and lemma, with the kernel's statement. Generated by `wasm/theory_test.mbt`; run `moon test --update` to refresh it.\n\nWord types are abbreviated: `Byte`, `W32`, `W64` and `W128` are `Word[...]` of 8, 32, 64 and 128 bits.",
    items,
  )
}
