// The theory as a document: every definition, datatype, relation and
// lemma the package makes, in the order it makes them, with the kernel's
// statement of each. `listing` writes it; wasm/theory_test.mbt keeps it
// in __snapshot__/theory.md, so the file always says what is proved.

///|
/// One entry of the listing: a heading, a datatype or constant (`text`),
/// or a definition, relation or lemma (`th`, its statement); with the
/// constants it defines and where in the source it is made.
priv struct Entry {
  kind : String
  name : String
  th : @kernel.Thm?
  text : String
  defines : Array[String]
  loc : String
}

///|
let entries : Array[Entry] = []

///|
/// A heading for the entries that follow.
fn section(title : String) -> Unit {
  entries.push({ kind: "section", name: title, th: None, text: "", defines: [], loc: "" })
}

///|
#callsite(autofill(loc))
fn list_entry(kind : String, name : String, th : @kernel.Thm, loc~ : SourceLoc) -> Unit {
  // a specification (new_specification) introduces the constant it names
  let defines = if kind == "specification" { [name] } else { defined_constants(kind, th) }
  entries.push({ kind, name, th: Some(th), text: "", defines, loc: loc.to_string() })
}

///|
#callsite(autofill(loc))
fn list_text(
  kind : String,
  name : String,
  text : String,
  defines : Array[String],
  loc~ : SourceLoc,
) -> Unit {
  entries.push({ kind, name, th: None, text, defines, loc: loc.to_string() })
}

///|
/// The word types, as the term syntax prints them, and short names for
/// them (longest first, so a longer type is replaced before its parts).
let type_names : Array[(String, String)] = [
  ("Word[Tybit0[Tybit0[Tybit0[Tybit0[Tybit0[Tybit0[Tybit0[Unit]]]]]]]]", "W128"),
  ("Word[Tybit0[Tybit0[Tybit0[Tybit0[Tybit0[Tybit0[Unit]]]]]]]", "W64"),
  ("Word[Tybit0[Tybit0[Tybit0[Tybit0[Tybit0[Unit]]]]]]", "W32"),
  ("Word[Tybit0[Tybit0[Tybit0[Unit]]]]", "Byte"),
]

///|
/// `s` with the word types written by their short names.
pub fn abbreviate_types(s : String) -> String {
  let mut out = s
  for p in type_names {
    out = out.replace_all(old=p.0, new=p.1)
  }
  out
}

///|
fn show_statement(th : @kernel.Thm) -> String {
  layout_statement(@kernel.concl(th))
}

///|
/// The listing in Markdown: `items` are (kind, name, statement), and a
/// ("section", title, _) is a heading for the items after it.
pub fn render_listing(
  title : String,
  intro : String,
  items : Array[(String, String, String)],
) -> String {
  let buf = StringBuilder()
  buf.write_string("# " + title + "\n\n" + intro + "\n")
  for e in items {
    let (kind, name, text) = e
    if kind == "section" {
      buf.write_string("\n## " + name + "\n")
    } else {
      buf.write_string("\n" + kind + " `" + name + "`\n\n```\n" + text + "\n```\n")
    }
  }
  buf.to_string()
}

///|
/// How the listings lay statements out, for their introductions.
pub let layout_note : String = "A statement is laid out as `∀ (x y : T) (z : U)`, its variables grouped by type; then, if it has hypotheses, `if` and the numbered hypotheses H1, ..., Hn and `then` and the conclusion C, with `or` between alternatives and `&&` before each further conjunct (as between a definition's equations). It stands for `∀ x y z, H1 && ... && Hn → C`. Each layout is printed from the kernel's statement and checked to read back as it (wasm/layout.mbt)."

///|
/// What this package defines and proves (loading it, and the facts about
/// reduction), as Markdown.
pub fn listing() -> String raise {
  load()
  props()
  let items = entries.map(fn(e) raise { (e.kind, e.name, entry_text(e)) })
  render_listing(
    "WasmCert in hol_light",
    "What package `wasm` defines and proves, in order: each definition, datatype, relation (its rules apart) and lemma, with the kernel's statement. Generated by `wasm/theory_test.mbt`; run `moon test --update` to refresh it.\n\nWord types are abbreviated: `Byte`, `W32`, `W64` and `W128` are `Word[...]` of 8, 32, 64 and 128 bits.\n\n" +
    layout_note,
    items,
  )
}

///|
/// An entry's statement or text, as the listing shows it.
fn entry_text(e : Entry) -> String raise {
  match e.th {
    Some(th) if e.kind == "relation" =>
      @bool.conjuncts_rule(th).to_array().map(show_statement).join("\n\n")
    Some(th) => show_statement(th)
    None => abbreviate_types(e.text)
  }
}

///|
/// What this package defines and proves, as data for a review site: a
/// JSON array of the entries in order (see `export_entry`).
pub fn listing_json() -> String raise {
  load()
  props()
  render_json(
    "wasm",
    entries.map(fn(e) raise {
      let uses = match e.th {
        Some(th) => term_constants(@kernel.concl(th))
        None => []
      }
      export_entry(e.kind, e.name, entry_text(e), uses, e.defines, e.loc)
    }),
  )
}

///|
/// The entries that define constants, in order: (name, the constants it
/// defines, the constants its statement uses). Package logic follows a
/// statement's constants through them to say what it depends on.
pub fn definitions() -> Array[(String, Array[String], Array[String])] raise {
  load()
  props()
  entries
  .filter(e => !e.defines.is_empty())
  .map(e => {
    let uses = match e.th {
      Some(th) => term_constants(@kernel.concl(th))
      None => []
    }
    (e.name, e.defines, uses)
  })
}
