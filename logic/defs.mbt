// Shared plumbing for the program logic: every definition and lemma is
// recorded under a name, read back with `thm` (as in package wasm).

///|
let thms : Map[String, @kernel.Thm] = Map([])

///|
/// A definition or lemma of the logic, by name.
pub fn thm(name : String) -> @kernel.Thm {
  load()
  match thms.get(name) {
    Some(th) => th
    None => abort("wasmcert/logic: no theorem " + name)
  }
}

///|
/// The names `thm` knows, in no particular order.
pub fn names() -> Array[String] {
  load()
  thms.keys().collect()
}

///|
fn record(name : String, th : @kernel.Thm, kind? : String = "lemma") -> Unit {
  if thms.contains(name) {
    abort("wasmcert/logic: " + name + " recorded twice")
  }
  thms[name] = th
  entries.push((kind, name, Some(th)))
}

///|
/// What `listing` shows, in order: (kind, name, theorem); a section is
/// ("section", title, None).
let entries : Array[(String, String, @kernel.Thm?)] = []

///|
/// A heading for the entries that follow.
fn section(title : String) -> Unit {
  entries.push(("section", title, None))
}

///|
/// The logic's types, as the term syntax prints them (after the word
/// types are shortened), and short names for them, longest first.
let type_names : Array[(String, String)] = [
  ("(List[Value], List[Value], (Num) -> Option[Byte]) -> Bool", "SAssn"),
  ("(Wstore, Wframe, List[Value]) -> Bool", "Assn"),
  ("((Num) -> Option[Byte]) -> Bool", "HProp"),
  ("(Num) -> Option[Byte]", "Heap"),
  ("(Limit_t, List[Byte])", "Mem"),
]

///|
/// What package `logic` defines and proves, in order, as Markdown.
pub fn listing() -> String raise {
  load()
  let items = entries.map(fn(e) raise {
    let (kind, name, th) = e
    let text = match th {
      Some(th) => {
        let mut text = @wasm.abbreviate_types(show(@kernel.concl(th)))
        for p in type_names {
          text = text.replace_all(old=p.0, new=p.1)
        }
        text
      }
      None => ""
    }
    (kind, name, text)
  })
  @wasm.render_listing(
    "A separation logic for WasmCert",
    "What package `logic` defines and proves, in order, with the kernel's statement of each (every lemma is a theorem: loading the package proves it). Generated by `logic/theory_test.mbt`; run `moon test --update` to refresh it.\n\nTypes are abbreviated: `Byte`, `W32`, `W64` are words of 8, 32, 64 bits; `Heap` is `(Num) -> Option[Byte]` (what each address holds); `HProp` is a heap assertion `(Heap) -> Bool`; `Mem` is a WasmCert memory `(Limit_t, List[Byte])`; `Assn` is `(Wstore, Wframe, List[Value]) -> Bool` (an assertion on store, frame and value stack); `SAssn` is `(List[Value], List[Value], Heap) -> Bool` (on the value stack, the locals and the memory as a heap).",
    items,
  )
}

///|
fn tm(s : String) -> @kernel.Term raise {
  @term_syntax.parse_term(s)
}

///|
/// A definition by equations, recorded as `name`.
fn def(name : String, s : String) -> Unit raise {
  let th = @define.define_(tm(s)) catch {
    e => raise Failure("wasmcert/logic: defining " + name + ": " + e.to_string())
  }
  record(name, th, kind="definition")
}

///|
let trace : Ref[Bool] = Ref::{ val: false }

///|
/// A lemma proved by `tac`, recorded as `name`.
fn lemma(name : String, stmt : String, tac : @tactics.Tactic) -> @kernel.Thm raise {
  let tac = if trace.val {
    println("proving " + name)
    @tactics.then_tac(tac, g => {
      for a in g.0 {
        println("  [" + a.0 + "] " + show(@kernel.concl(a.1)))
      }
      println("  ⊢ " + show(g.1))
      @tactics.all_tac(g)
    })
  } else {
    tac
  }
  let th = @tactics.prove(tm(stmt), tac) catch {
    e => raise Failure("wasmcert/logic: proving " + name + ": " + e.to_string())
  }
  record(name, th)
  th
}

///|
fn show(t : @kernel.Term) -> String {
  @term_syntax.print_term(t) catch {
    _ => (try @printer.string_of_term(t) catch { _ => "?" })
  }
}

///|
fn seq(tacs : Array[@tactics.Tactic]) -> @tactics.Tactic {
  @tactics.every(@list.List(tacs))
}

///|
fn ths(xs : Array[@kernel.Thm]) -> @list.List[@kernel.Thm] {
  @list.List(xs)
}

///|
/// Word types in the term syntax, as in package wasm.
let w8 : String = "Word[Tybit0[Tybit0[Tybit0[Unit]]]]"

///|
let w32 : String = "Word[Tybit0[Tybit0[Tybit0[Tybit0[Tybit0[Unit]]]]]]"

///|
/// A heap: what each address holds, NONE outside it.
let heap : String = "(Num) -> Option[\{w8}]"

///|
/// A heap assertion.
let hprop : String = "(\{heap}) -> Bool"

///|
/// WasmCert's memories: a limit and the bytes.
let mem_ty : String = "(Limit_t, List[\{w8}])"

///|
/// Substitutes the assumptions `x == t` (x a variable) everywhere.
fn subst_vars() -> @tactics.Tactic {
  @tactics.repeat_tac(@tactics.first_x_assum(@tactics.subst_var_tac))
}

///|
/// Prints the goal (when tracing), for debugging proofs.
fn show_goal(label : String) -> @tactics.Tactic {
  g => {
    if trace.val {
      println("goal at " + label + ":")
      for a in g.0 {
        println("  [" + a.0 + "] " + show(@kernel.concl(a.1)))
      }
      println("  ⊢ " + show(g.1))
    }
    @tactics.all_tac(g)
  }
}

///|
/// `mp_tac` of `lemma` (∀ xs. A && B → C) applied to the first two
/// assumptions that match A and B.
fn forward2(lemma : @kernel.Thm) -> @tactics.Tactic {
  g => {
    let asms = g.0.to_array()
    for a in asms {
      for b in asms {
        let th : @kernel.Thm? = Some(@drule.match_mp(lemma)(@bool.conj(a.1, b.1))) catch {
          _ => None
        }
        if th is Some(th) {
          return @tactics.mp_tac(th)(g)
        }
      }
    }
    raise Failure("forward2: no assumptions match")
  }
}

///|
/// asm_meson_tac with `lemmas`, naming the goal (when tracing) if it fails.
fn meson_at(label : String, lemmas : Array[@kernel.Thm]) -> @tactics.Tactic {
  g => {
    @meson.asm_meson_tac(ths(lemmas))(g) catch {
      e => {
        if trace.val {
          println("meson failed at " + label + ":")
          ignore(show_goal(label)(g))
        }
        raise e
      }
    }
  }
}

///|
/// `tac`, naming the goal (when tracing) if it fails.
fn named(label : String, tac : @tactics.Tactic) -> @tactics.Tactic {
  g => {
    tac(g) catch {
      e => {
        if trace.val {
          println("failed at " + label + ": " + e.to_string())
          ignore(show_goal(label)(g))
        }
        raise e
      }
    }
  }
}
