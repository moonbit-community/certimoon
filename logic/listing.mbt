// The theory as a document: every definition and lemma the package makes,
// in the order it makes them, with the kernel's statement of each.
// logic/theory_test.mbt keeps it in __snapshot__/theory.md.

///|
/// What `listing` shows, in order: (kind, name, theorem); a section is
/// ("section", title, None).
let entries : Array[(String, String, @kernel.Thm?)] = []

///|
/// A heading for the entries that follow.
fn section(title : String) -> Unit {
  entries.push(("section", title, None))
}

///|
/// The logic's types, as the term syntax prints them (after the word
/// types are shortened), and short names for them, longest first.
let type_names : Array[(String, String)] = [
  ("(List[Value], List[Value], List[Value], (Num) -> Option[Byte]) -> Bool", "SAssn"),
  ("(List[Value], (Num) -> Option[Byte]) -> Bool", "GProp"),
  ("(Wstore, Wframe, List[Value]) -> Bool", "Assn"),
  ("((Num) -> Option[Byte]) -> Bool", "HProp"),
  ("(Num) -> Option[Byte]", "Heap"),
  ("(Limit_t, List[Byte])", "Mem"),
]

///|
/// `th`'s statement, with the long types written by their short names.
fn statement(th : @kernel.Thm) -> String {
  let mut text = @wasm.abbreviate_types(show(@kernel.concl(th)))
  for p in type_names {
    text = text.replace_all(old=p.0, new=p.1)
  }
  text
}

///|
/// What package `logic` defines and proves, in order, as Markdown.
pub fn listing() -> String {
  load()
  let items = entries.map(e => {
    let (kind, name, th) = e
    (kind, name, if th is Some(th) { statement(th) } else { "" })
  })
  @wasm.render_listing(
    "A separation logic for WasmCert",
    "What package `logic` defines and proves, in order, with the kernel's statement of each (every lemma is a theorem: loading the package proves it). Generated by `logic/theory_test.mbt`; run `moon test --update` to refresh it.\n\nTypes are abbreviated: `Byte`, `W32`, `W64` are words of 8, 32, 64 bits; `Heap` is `(Num) -> Option[Byte]` (what each address holds); `HProp` is a heap assertion `(Heap) -> Bool`; `Mem` is a WasmCert memory `(Limit_t, List[Byte])`; `Assn` is `(Wstore, Wframe, List[Value]) -> Bool` (an assertion on store, frame and value stack); `SAssn` is `(List[Value], List[Value], List[Value], Heap) -> Bool` (on the value stack, the locals, the globals and the memory as a heap); `GProp` is `(List[Value], Heap) -> Bool` (on the globals and the heap, the `R` of an exact state `st(v, l, R)`).",
    items,
  )
}
