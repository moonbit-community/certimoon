// The theory as a document: every definition and lemma the package makes,
// in the order it makes them, with the kernel's statement of each.
// logic/logic_test.mbt keeps it in __snapshot__/theory.md.

///|
/// An entry of the listing: a definition, lemma or example, or a section
/// (with its title as `name` and no theorem); with the constants it
/// defines and where in the source it is made.
priv struct Entry {
  kind : String
  name : String
  th : @kernel.Thm?
  defines : Array[String]
  loc : String
}

///|
/// What `listing` shows, in order.
let entries : Array[Entry] = []

///|
/// A heading for the entries that follow.
fn section(title : String) -> Unit {
  entries.push({ kind: "section", name: title, th: None, defines: [], loc: "" })
}

///|
/// The logic's types, as the term syntax prints them (after the word
/// types are shortened), and short names for them, longest first.
let type_names : Array[(String, String)] = [
  ("(List[Value], List[Value], List[Value], Num, (Num) -> Option[Byte]) -> Bool", "SAssn"),
  ("(List[Value], Num, (Num) -> Option[Byte]) -> Bool", "GProp"),
  ("(Wstore, Wframe, List[Value]) -> Bool", "Assn"),
  ("((Num) -> Option[Byte]) -> Bool", "HProp"),
  ("(Num) -> Option[Byte]", "Heap"),
  ("(Limit_t, List[Byte])", "Mem"),
]

///|
/// `s` with the long types written by their short names.
fn abbreviate(s : String) -> String {
  let mut text = @wasm.abbreviate_types(s)
  for p in type_names {
    text = text.replace_all(old=p.0, new=p.1)
  }
  text
}

///|
/// `th`'s statement, laid out, with the long types written by their short
/// names.
fn statement(th : @kernel.Thm) -> String {
  @wasm.layout_statement(@kernel.concl(th), abbreviate~)
}

///|
/// What package `logic` defines and proves, in order, as Markdown.
pub fn listing() -> String {
  load()
  let items = entries.map(e => {
    (e.kind, e.name, if e.th is Some(th) { statement(th) } else { "" })
  })
  @wasm.render_listing(
    "A separation logic for WasmCert",
    "What package `logic` defines and proves, in order, with the kernel's statement of each (every lemma is a theorem: loading the package proves it). Generated by `logic/logic_test.mbt`; run `moon test --update` to refresh it.\n\nTypes are abbreviated: `Byte`, `W32`, `W64` are words of 8, 32, 64 bits; `Heap` is `(Num) -> Option[Byte]` (what each address holds); `HProp` is a heap assertion `(Heap) -> Bool`; `Mem` is a WasmCert memory `(Limit_t, List[Byte])`; `Assn` is `(Wstore, Wframe, List[Value]) -> Bool` (an assertion on store, frame and value stack); `SAssn` is `(List[Value], List[Value], List[Value], Num, Heap) -> Bool` (on the value stack, the locals, the globals, the memory's length in bytes and the memory as a heap); `GProp` is `(List[Value], Num, Heap) -> Bool` (on the globals, the memory's length and the heap, the `R` of an exact state `st(v, l, R)`).\n\n" +
    @wasm.layout_note,
    items,
  )
}

///|
/// What package `logic` defines and proves, as data for a review site
/// (see `@wasm.export_entry`).
pub fn listing_json() -> String raise {
  load()
  @wasm.render_json(
    "logic",
    entries.map(fn(e) raise {
      let (text, uses) = match e.th {
        Some(th) => (statement(th), @wasm.term_constants(@kernel.concl(th)))
        None => ("", [])
      }
      if e.kind == "theorem" || e.kind == "example" {
        let (deps, outside) = depends_on(uses)
        let depends = deps.map(d => d.0 + "/" + d.1)
        @wasm.export_entry(e.kind, e.name, text, uses, e.defines, e.loc, depends~, outside~)
      } else {
        @wasm.export_entry(e.kind, e.name, text, uses, e.defines, e.loc)
      }
    }),
  )
}

///|
/// The entries of both packages that define constants, in listing order
/// (wasm's first): (package, name, constants defined, constants used).
fn all_definitions() -> Array[(String, String, Array[String], Array[String])] raise {
  let out = @wasm.definitions().map(d => ("wasm", d.0, d.1, d.2))
  for e in entries {
    if !e.defines.is_empty() && e.th is Some(th) {
      out.push(("logic", e.name, e.defines, @wasm.term_constants(@kernel.concl(th))))
    }
  }
  out
}

///|
/// What a statement using the constants `uses` depends on: the entries
/// that define them, and those that define the constants of those
/// entries' statements, and so on (package, name), in listing order; and
/// the constants left, which no entry of either package defines
/// (hol_light's), sorted.
pub fn depends_on(
  uses : Array[String],
) -> (Array[(String, String)], Array[String]) raise {
  load()
  let defs = all_definitions()
  let definer : Map[String, Int] = Map([])
  for i, d in defs {
    for c in d.2 {
      if !definer.contains(c) {
        definer[c] = i
      }
    }
  }
  let need : Set[Int] = Set([])
  let outside : Set[String] = Set([])
  let todo = uses.copy()
  while todo.pop() is Some(c) {
    match definer.get(c) {
      None => outside.add(c)
      Some(i) =>
        if !need.contains(i) {
          need.add(i)
          for u in defs[i].3 {
            todo.push(u)
          }
        }
    }
  }
  let deps = []
  for i, d in defs {
    if need.contains(i) {
      deps.push((d.0, d.1))
    }
  }
  let rest = outside.iter().collect()
  rest.sort()
  (deps, rest)
}

///|
/// What each closed theorem depends on, as Markdown: every definition, by
/// package, and the constants of hol_light it uses; and for each example
/// (a triple), how many definitions. A change to what a theorem trusts
/// shows in this file's diff.
pub fn dependencies() -> String raise {
  load()
  let buf = StringBuilder()
  buf.write_string(
    "# What each theorem depends on\n\nTo trust a theorem, a reviewer reads its statement and the definitions it depends on: those defining the constants of its statement, and those defining the constants of theirs, through package logic and into package wasm, until only hol_light's constants are left. The proofs need no reading: the kernel checks them, and neither package adds an axiom. Generated by `logic/logic_test.mbt`; run `moon test --update` to refresh it.\n",
  )
  let summary = (deps : Array[(String, String)]) => {
    let w = deps.filter(d => d.0 == "wasm").length()
    "\{deps.length()} definitions: \{w} in wasm, \{deps.length() - w} in logic"
  }
  for e in entries {
    guard e.kind == "theorem" && e.th is Some(th) else { continue }
    let (deps, outside) = depends_on(@wasm.term_constants(@kernel.concl(th)))
    buf.write_string("\n## Theorem `\{e.name}`\n\n\{summary(deps)}.\n")
    for pkg in ["logic", "wasm"] {
      let names = deps.filter(d => d.0 == pkg).map(d => d.1)
      buf.write_string("\n### From \{pkg} (\{names.length()})\n\n```\n" + names.join("\n") + "\n```\n")
    }
    buf.write_string(
      "\n### From hol_light (\{outside.length()} constants)\n\n```\n" + outside.join("\n") + "\n```\n",
    )
  }
  buf.write_string("\n## Examples\n\nTriples of verified programs, with what their statements depend on.\n\n| Example | Definitions | In wasm | In logic |\n|---|---|---|---|\n")
  for e in entries {
    guard e.kind == "example" && e.th is Some(th) else { continue }
    let (deps, _) = depends_on(@wasm.term_constants(@kernel.concl(th)))
    let w = deps.filter(d => d.0 == "wasm").length()
    buf.write_string("| `\{e.name}` | \{deps.length()} | \{w} | \{deps.length() - w} |\n")
  }
  buf.to_string()
}
